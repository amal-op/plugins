{
    "name": "vio/customer-prices",
    "version": "1.16.7",
    "description": "Shopware 6 plugin, to maintain and consider customer specific prices.",
    "type": "shopware-platform-plugin",
    "license": "proprietary",
    "keywords": [
        "shopware",
        "customer",
        "price"
    ],
    "autoload": {
        "psr-4": {
            "VioCustomerPrice\\": "src/"
        }
    },
    "authors": [
        {
            "name": "VIOSYS AG"
        }
    ],
    "require": {
        "php": "~8.2.0 || ~8.3.0",
        "shopware/core": ">=6.6 < 6.7",
        "shopware/administration": ">=6.6 < 6.7",
        "shopware/storefront": ">=6.6 < 6.7"
    },
    "extra": {
        "shopware-plugin-class": "VioCustomerPrice\\VioCustomerPrice",
        "copyright": "(c) by VIOSYS AG",
        "plugin-icon": "plugin.png",
        "label": {
            "de-DE": "VIO.kundenspezifische Preise",
            "en-GB": "VIO.customer specific prices"
        },
        "description": {
            "de-DE": "Plugin zum pflegen und beachten von kundenspezifischen Preisen.",
            "en-GB": "Plugin to maintain and consider customer specific prices."
        },
        "manufacturerLink": {
            "de-DE": "https://www.viosys.de/",
            "en-GB": "https://www.viosys.de/"
        },
        "supportLink": {
            "de-DE": "https://www.viosys.de/kontakt",
            "en-GB": "https://www.viosys.de/kontakt"
        }
    },
    "require-dev": {
        "rector/rector": "^1.0",
        "frosh/shopware-rector": "^0.3.0"
    },
    "config": {
        "allow-plugins": {
            "symfony/runtime": true
        }
    }
}
