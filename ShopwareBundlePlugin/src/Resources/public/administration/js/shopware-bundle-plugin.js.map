export default "{% block sw_cms_element_cmsbundle_background_image_config_config %}\n\t<div class=\"sw-cms-el-config-cmsbundle-background-image\">\n\t\t{% block sw_cms_element_cmsbundle_background_image_config_tabs %}\n\t\t\t<sw-tabs default-item=\"image\">\n\t\t\t\t<template #default=\"{ active }\">\n\t\t\t\t\t{% block sw_cms_element_cmsbundle_background_image_config_tab_image %}\n\t\t\t\t\t\t<sw-tabs-item name=\"image\" :active-tab=\"active\">\n\t\t\t\t\t\t\t{{ $tc('cmsbundle.element.general.tabs.background') }}\n\t\t\t\t\t\t</sw-tabs-item>\n\t\t\t\t\t{% endblock %}\n\t\t\t\t\t{% block sw_cms_element_cmsbundle_background_image_config_tab_setting %}\n\t\t\t\t\t\t<sw-tabs-item name=\"setting\" :active-tab=\"active\">\n\t\t\t\t\t\t\t{{ $tc('cmsbundle.element.general.config.setting') }}\n\t\t\t\t\t\t</sw-tabs-item>\n\t\t\t\t\t{% endblock %}\n\t\t\t\t</template>\n\t\t\t\t<template #content=\"{ active }\">\n\t\t\t\t\t<div v-if=\"active === 'image'\" class=\"sw-cms-el-config-cmsbundle-image\">\n\t\t\t\t\t\t{% block sw_cms_element_cmsbundle_background_image_config_desktop_media_upload %}\n\t\t\t\t\t\t\t<sw-container class=\"sw-cms-el-config-cmsbundle-image-field\">\n\t\t\t\t\t\t\t\t<sw-cms-mapping-field v-model=\"element.config.mediaDesktop\" :label=\"$tc('cmsbundle.element.general.config.desktop')\" value-types=\"entity\" entity=\"media\">\n\t\t\t\t\t\t\t\t\t<sw-media-upload-v2 variant=\"regular\" :upload-tag=\"uploadTagDesktop\" :source=\"previewSourceDesktop\" :allow-multi-select=\"false\" :default-folder=\"cmsPageState.pageEntityName\" :caption=\"$tc('sw-cms.elements.general.config.caption.mediaUpload')\" @media-upload-sidebar-open=\"onOpenMediaModalDesktop\" @media-upload-remove-image=\"onImageRemoveDesktop\"/>\n\t\t\t\t\t\t\t\t\t<div slot=\"preview\" slot-scope=\"{ demoValue }\" class=\"sw-cms-el-config-image__mapping-preview\">\n\t\t\t\t\t\t\t\t\t\t<img v-if=\"demoValue.url\" :src=\"demoValue.url\" alt=\"\">\n\t\t\t\t\t\t\t\t\t\t<sw-alert v-else class=\"sw-cms-el-config-image__preview-info\" variant=\"info\">\n\t\t\t\t\t\t\t\t\t\t\t{{ $tc('sw-cms.detail.label.mappingEmptyPreview') }}\n\t\t\t\t\t\t\t\t\t\t</sw-alert>\n\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t</sw-cms-mapping-field>\n\t\t\t\t\t\t\t\t<sw-upload-listener :upload-tag=\"uploadTagDesktop\" auto-upload @media-upload-finish=\"onImageUploadDesktop\"/>\n\t\t\t\t\t\t\t</sw-container>\n\t\t\t\t\t\t{% endblock %}\n\t\t\t\t\t\t{% block sw_cms_element_cmsbundle_background_image_config_tablet_media_upload %}\n\t\t\t\t\t\t\t<sw-container class=\"sw-cms-el-config-cmsbundle-image-field\">\n\t\t\t\t\t\t\t\t<sw-cms-mapping-field v-model=\"element.config.mediaTablet\" :label=\"$tc('cmsbundle.element.general.config.tablet')\" value-types=\"entity\" entity=\"media\">\n\t\t\t\t\t\t\t\t\t<sw-media-upload-v2 variant=\"regular\" :upload-tag=\"uploadTagTablet\" :source=\"previewSourceTablet\" :allow-multi-select=\"false\" :default-folder=\"cmsPageState.pageEntityName\" :caption=\"$tc('sw-cms.elements.general.config.caption.mediaUpload')\" @media-upload-sidebar-open=\"onOpenMediaModalTablet\" @media-upload-remove-image=\"onImageRemoveTablet\"/>\n\t\t\t\t\t\t\t\t\t<div slot=\"preview\" slot-scope=\"{ demoValue }\" class=\"sw-cms-el-config-image__mapping-preview\">\n\t\t\t\t\t\t\t\t\t\t<img v-if=\"demoValue.url\" :src=\"demoValue.url\" alt=\"\">\n\t\t\t\t\t\t\t\t\t\t<sw-alert v-else class=\"sw-cms-el-config-image__preview-info\" variant=\"info\">\n\t\t\t\t\t\t\t\t\t\t\t{{ $tc('sw-cms.detail.label.mappingEmptyPreview') }}\n\t\t\t\t\t\t\t\t\t\t</sw-alert>\n\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t</sw-cms-mapping-field>\n\t\t\t\t\t\t\t\t<sw-upload-listener :upload-tag=\"uploadTagTablet\" auto-upload @media-upload-finish=\"onImageUploadTablet\"/>\n\t\t\t\t\t\t\t</sw-container>\n\t\t\t\t\t\t{% endblock %}\n\t\t\t\t\t\t{% block sw_cms_element_cmsbundle_background_image_config_mobile_media_upload %}\n\t\t\t\t\t\t\t<sw-container class=\"sw-cms-el-config-cmsbundle-image-field\">\n\t\t\t\t\t\t\t\t<sw-cms-mapping-field v-model=\"element.config.mediaMobile\" :label=\"$tc('cmsbundle.element.general.config.mobile')\" value-types=\"entity\" entity=\"media\">\n\t\t\t\t\t\t\t\t\t<sw-media-upload-v2 variant=\"regular\" :upload-tag=\"uploadTagMobile\" :source=\"previewSourceMobile\" :allow-multi-select=\"false\" :default-folder=\"cmsPageState.pageEntityName\" :caption=\"$tc('sw-cms.elements.general.config.caption.mediaUpload')\" @media-upload-sidebar-open=\"onOpenMediaModalMobile\" @media-upload-remove-image=\"onImageRemoveMobile\"/>\n\t\t\t\t\t\t\t\t\t<div slot=\"preview\" slot-scope=\"{ demoValue }\" class=\"sw-cms-el-config-image__mapping-preview\">\n\t\t\t\t\t\t\t\t\t\t<img v-if=\"demoValue.url\" :src=\"demoValue.url\" alt=\"\">\n\t\t\t\t\t\t\t\t\t\t<sw-alert v-else class=\"sw-cms-el-config-image__preview-info\" variant=\"info\">\n\t\t\t\t\t\t\t\t\t\t\t{{ $tc('sw-cms.detail.label.mappingEmptyPreview') }}\n\t\t\t\t\t\t\t\t\t\t</sw-alert>\n\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t</sw-cms-mapping-field>\n\t\t\t\t\t\t\t\t<sw-upload-listener :upload-tag=\"uploadTagMobile\" auto-upload @media-upload-finish=\"onImageUploadMobile\"/>\n\t\t\t\t\t\t\t</sw-container>\n\t\t\t\t\t\t{% endblock %}\n\n\t\t\t\t\t\t{% block sw_cms_element_cmsbundle_background_image_config_desktop_media_modal %}\n\t\t\t\t\t\t\t<sw-media-modal-v2 v-if=\"mediaModalIsOpenDesktop\" variant=\"regular\" :caption=\"$tc('sw-cms.elements.general.config.caption.mediaUpload')\" :entity-context=\"cmsPageState.entityName\" :allow-multi-select=\"false\" :initial-folder-id=\"cmsPageState.defaultMediaFolderId\" @media-upload-remove-image=\"onImageRemoveDesktop\" @media-modal-selection-change=\"onSelectionChangesDesktop\" @modal-close=\"onCloseModalDesktop\"/>\n\t\t\t\t\t\t{% endblock %}\n\t\t\t\t\t\t{% block sw_cms_element_cmsbundle_background_image_config_tablet_media_modal %}\n\t\t\t\t\t\t\t<sw-media-modal-v2 v-if=\"mediaModalIsOpenTablet\" variant=\"regular\" :caption=\"$tc('sw-cms.elements.general.config.caption.mediaUpload')\" :entity-context=\"cmsPageState.entityName\" :allow-multi-select=\"false\" :initial-folder-id=\"cmsPageState.defaultMediaFolderId\" @media-upload-remove-image=\"onImageRemoveTablet\" @media-modal-selection-change=\"onSelectionChangesTablet\" @modal-close=\"onCloseModalTablet\"/>\n\t\t\t\t\t\t{% endblock %}\n\t\t\t\t\t\t{% block sw_cms_element_cmsbundle_background_image_config_mobile_media_modal %}\n\t\t\t\t\t\t\t<sw-media-modal-v2 v-if=\"mediaModalIsOpenMobile\" variant=\"regular\" :caption=\"$tc('sw-cms.elements.general.config.caption.mediaUpload')\" :entity-context=\"cmsPageState.entityName\" :allow-multi-select=\"false\" :initial-folder-id=\"cmsPageState.defaultMediaFolderId\" @media-upload-remove-image=\"onImageRemoveMobile\" @media-modal-selection-change=\"onSelectionChangesMobile\" @modal-close=\"onCloseModalMobile\"/>\n\t\t\t\t\t\t{% endblock %}\n\t\t\t\t\t\t{% block sw_cms_element_cmsbundle_background_image_colour %}\n\t\t\t\t\t\t\t<div class=\"sw-cms-el-config-cmsbundle-hero-slider-colour\">\n\t\t\t\t\t\t\t\t<sw-colorpicker v-model=\"element.config.colour.value\" class=\"sw-cms-el-config-cmsbundle-hero-slider-colour\" type=\"text\" :label=\"$tc('cmsbundle.element.general.config.background-color')\" coloroutput=\"auto\" :alpha=\"true\" :disabled=\"false\" :colorlabels=\"true\" zindex=\"100\"/>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t{% endblock %}\n\t\t\t\t\t\t{% block sw_cms_element_cmsbundle_hero_slider_config_lazy_load %}\n\t\t\t\t\t\t\t<div class=\"sw-cms-el-config-cmsbundle-hero-slider-lazy-load\">\n\t\t\t\t\t\t\t\t<sw-field v-model=\"element.config.lazyLoad.value\" class=\"sw-cms-el-config-cmsbundle-hero-slider-lazy-load\" type=\"switch\" :label=\"$tc('cmsbundle.element.general.config.enable-lazy-load')\"/>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t{% endblock %}\n\t\t\t\t\t</div>\n\n\t\t\t\t\t<div v-if=\"active==='setting'\" class=\"sw-cms-el-config-cmsbundle-image\">\n\t\t\t\t\t\t{% block sw_cms_element_cmsbundle_background_image_config_media_upload_setting %}\n\n\t\t\t\t\t\t\t<div class=\"sw-field-row\">\n\t\t\t\t\t\t\t\t{% block sw_cms_element_cmsbundle_background_image_config_options %}\n\t\t\t\t\t\t\t\t\t<sw-select-field v-model=\"element.config.alignment.value\" class=\"sw-cms-el-config-cmsbundle-background-image__alignment pr-10px sw-field-item\" :label=\"$tc('sw-cms.elements.general.config.label.alignment')\" :placeholder=\"$tc('sw-cms.elements.general.config.label.alignment')\">\n\n\t\t\t\t\t\t\t\t\t\t{% block sw_cms_element_cmsbundle_background_image_config_alignment_options %}\n\t\t\t\t\t\t\t\t\t\t\t<option value=\"flex-start\">\n\t\t\t\t\t\t\t\t\t\t\t\t{{ $tc('sw-cms.elements.general.config.label.verticalAlignTop') }}\n\t\t\t\t\t\t\t\t\t\t\t</option>\n\t\t\t\t\t\t\t\t\t\t\t<option value=\"center\">\n\t\t\t\t\t\t\t\t\t\t\t\t{{ $tc('sw-cms.elements.general.config.label.verticalAlignCenter') }}\n\t\t\t\t\t\t\t\t\t\t\t</option>\n\t\t\t\t\t\t\t\t\t\t\t<option value=\"flex-end\">\n\t\t\t\t\t\t\t\t\t\t\t\t{{ $tc('sw-cms.elements.general.config.label.verticalAlignBottom') }}\n\t\t\t\t\t\t\t\t\t\t\t</option>\n\t\t\t\t\t\t\t\t\t\t{% endblock %}\n\n\t\t\t\t\t\t\t\t\t</sw-select-field>\n\t\t\t\t\t\t\t\t{% endblock %}\n\t\t\t\t\t\t\t\t{% block sw_cms_element_cmsbundle_background_image_config_custom_class %}\n\t\t\t\t\t\t\t\t\t<sw-field v-model=\"element.config.customClass.value\" class=\"sw-cms-el-config-cmsbundle-image-custom-class sw-field-item\" type=\"text\" :label=\"$tc('cmsbundle.element.general.config.custom-class')\"/>\n\t\t\t\t\t\t\t\t{% endblock %}\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t{% endblock %}\n\t\t\t\t\t</div>\n\t\t\t\t</template>\n\t\t\t</sw-tabs>\n\t\t{% endblock %}\n\t</div>\n{% endblock %}\n";