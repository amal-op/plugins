export default "{% block sw_cms_element_cmsbundle_cta_block %}\n<div class=\"sw-cms-el-cmsbundle-cta-block\">\n    {% block sw_cms_element_cmsbundle_cta_block_content %}\n    <div class=\"sw-cms-el-cmsbundle-cta__content\">\n\t\t\t\t<img v-if=\"(!title && !subTitle && !shortDescription && !content && !mediaUrl)\" :src=\"'/shopwarebundleplugin/static/img/cta-element.jpg' | asset\" alt=\"\"/>\n\t\t\t\t<img v-else-if=\"(title || subTitle || shortDescription || content)\" :src=\"'/shopwarebundleplugin/static/img/column-banner.png' | asset\" alt=\"\"/>\n\t\t\t\t<div v-if=\"title || subTitle || shortDescription || content\" class=\"sw-cms-el-cmsbundle-cta__content-text\" :style=\"contentStyle\">\n\t\t\t\t\t<div v-html=\"title\"></div>\n\t\t\t\t\t<div v-html=\"subTitle\"></div>\n\t\t\t\t\t<div>{{shortDescription}}</div>\n\t\t\t\t\t<p v-html=\"content\" class=\"sw-cms-el-cmsbundle-cta__content-text__content\"></p>\n\t\t\t\t</div>\n\t\t\t</div>\n    \n    {% endblock %}\n</div>\n{% endblock %}\n";