export default "{% block sw_cms_element_cmsbundle_cta %}\n\t<div class=\"sw-cms-el-cmsbundle-cta\">\n\t\t{% block sw_cms_element_cmsbundle_cta_content %}\n\t\t\t<div class=\"sw-cms-el-cmsbundle-cta__content\" :style=\"backgroundStyle\">\n\t\t\t\t<img v-if=\"(!title && !subTitle && !shortDescription && !content) || staticFallBackImageDesktop!=backgroundMediaUrl\" :src=\"backgroundMediaUrl\" alt=\"\"/>\n\t\t\t\t<img v-if=\"(title || subTitle || shortDescription || content) && staticFallBackImageDesktop==backgroundMediaUrl\" :src=\"'/shopwarebundleplugin/static/img/vertical-column.jpg' | asset\" alt=\"\" />\n\t\t\t\t<div v-if=\"title || subTitle || shortDescription || content\" class=\"sw-cms-el-cmsbundle-cta__content-text\" :style=\"contentStyle\">\n\t\t\t\t\t<div v-html=\"title\"></div>\n\t\t\t\t\t<div v-html=\"subTitle\"></div>\n\t\t\t\t\t<div class=\"description-text\">{{shortDescription}}</div>\n\t\t\t\t\t<p v-html=\"content\" class=\"sw-cms-el-cmsbundle-cta__content-text__content\"></p>\n\t\t\t\t</div>\n\t\t\t</div>\n\t\t{% endblock %}\n\t</div>\n{% endblock %}\n";