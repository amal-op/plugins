export default "{% block sw_cms_element_category_slider %}\n\t<div class=\"sw-cms-el-category-slider\" :class=\"classes\" :style=\"verticalAlignStyle\">\n\n\n\t\t{% block sw_cms_element_category_slider_content %}\n\t\t\t<div class=\"sw-cms-el-category-slider__content\">\n\n\t\t\t\t{% block sw_cms_element_category_slider_arrow_left %}\n\t\t\t\t\t<div v-if=\"hasNavigation\" class=\"sw-cms-el-category-slider__navigation\">\n\t\t\t\t\t\t<sw-icon class=\"sw-cms-el-category-slider__navigation-button\" name=\"regular-chevron-left\" size=\"24\"/>\n\t\t\t\t\t</div>\n\t\t\t\t{% endblock %}\n\n\t\t\t\t{% block sw_cms_element_category_slider_category_holder %}\n\t\t\t\t\t<div ref=\"categoryHolder\" class=\"sw-cms-el-category-slider__product-holder\">\n\n\t\t\t\t\t\t{% block sw_cms_element_category_slider_demo_data %}\n\t\t\t\t\t\t\t<div v-for=\"index in getDummyBoxes(sliderBoxLimit)\" :key=\"index\" :element=\"demoCategoryElement\" style=\"flex-grow: 1;\">\n\t\t\t\t\t\t\t\t<div class=\"sw-cms-el-category-box box-standard\">\n\t\t\t\t\t\t\t\t\t<div class=\"sw-cms-el-category-box__content\">\n\t\t\t\t\t\t\t\t\t\t<div class=\"sw-cms-el-category-box__media\">\n\t\t\t\t\t\t\t\t\t\t\t<a href=\"#\" title=\"Variant product\" class=\"sw-cms-el-category-box__image-link\"><img :src=\"mediaUrl()\" class=\"sw-cms-el-category-box__image\"></a>\n\t\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t\t\t<div>\n\t\t\t\t\t\t\t\t\t\t\t{{ $tc('cmsbundle.element.general.config.category') }}\n\t\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t{% endblock %}\n\t\t\t\t\t</div>\n\t\t\t\t{% endblock %}\n\n\t\t\t\t{% block sw_cms_element_product_slider_arrow_right %}\n\t\t\t\t\t<div v-if=\"hasNavigation\" class=\"sw-cms-el-category-slider__navigation\">\n\t\t\t\t\t\t<sw-icon class=\"sw-cms-el-category-slider__navigation-button\" name=\"regular-chevron-right\" size=\"24\"/>\n\t\t\t\t\t</div>\n\t\t\t\t{% endblock %}\n\t\t\t</div>\n\t\t{% endblock %}\n\t</d