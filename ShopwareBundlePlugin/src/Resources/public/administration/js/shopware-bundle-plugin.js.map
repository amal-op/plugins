export default "{% block sw_cms_element_config_cmsbundle_nav_tabs %}\n\t<div class=\"sw-cms-el-config-cmsbundle-nav-tabs\">\n\t\t<sw-tabs class=\"sw-cms-el-config-rhweb-tabs__tabs\" default-item=\"content\">\n\t\t\t<template slot-scope=\"{ active }\">\n\t\t\t\t{% block sw_cms_element_config_cmsbundle_nav_tabs_tabs %}\n\t\t\t\t\t<sw-tabs-item :title=\"$tc('cmsbundle.element.general.tabs.content')\" name=\"content\" :active-tab=\"active\">\n\t\t\t\t\t\t{{$tc('cmsbundle.element.general.tabs.content')}}\n\t\t\t\t\t</sw-tabs-item>\n\t\t\t\t{% endblock %}\n\t\t\t</template>\n\t\t\t<template slot=\"content\" slot-scope=\"{ active }\">\n\t\t\t\t{% block sw_cms_element_cmsbundle_accordion_config_content %}\n\t\t\t\t\t<sw-container v-if=\"active == 'content'\" class=\"sw-cms-el-config-cmsbundle-accordion__content\">\n\t\t\t\t\t\t<sw-collapse v-for=\"(entry, index) in element.config.data.value\" :key=\"index\" :ref=\"'collapse_' + index\">\n\t\t\t\t\t\t\t<template #header=\"{ expanded }\">\n\t\t\t\t\t\t\t\t<div class=\"collapse-header\" :class=\"expanded ? 'expanded' : ''\">\n\t\t\t\t\t\t\t\t\t{# <div class=\"drag-indicator\">\n\t\t\t\t\t\t\t\t\t\t<sw-icon name=\"regular-questionmark-s\"></sw-icon>\n\t\t\t\t\t\t\t\t\t</div> #}\n\t\t\t\t\t\t\t\t\t<div class=\"text\">{{entry.name}}</div>\n\t\t\t\t\t\t\t\t\t<sw-button variant=\"danger\" class=\"right\" @click=\"showDeleteConfirmation(index)\">Delete</sw-button>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t<sw-confirm-modal v-if=\"deleteConfirmationIndex === index\" class=\"sw-my-component__confirm-delete-modal\" type=\"delete\" :text=\"$tc('cmsbundle.element.accordion.config.delete-confirm')\" @confirm=\"deleteItem(index)\" @cancel=\"cancelDelete\"></sw-confirm-modal>\n\t\t\t\t\t\t\t</template>\n\t\t\t\t\t\t\t<template #content class=\"collapse-content\">\n\t\t\t\t\t\t\t\t<sw-field type=\"text\" :label=\"$tc('cmsbundle.element.accordion.config.title')\" :help-text=\"$tc('cmsbundle.element.accordion.config.title-help')\" v-model=\"entry.name\"></sw-field>\n\n\t\t\t\t\t\t\t\t<sw-text-editor v-model=\"entry.content\" mode=\"twig\" :label=\"$tc('cmsbundle.element.accordion.config.content')\" :softwraps=\"true\"></sw-text-editor>\n\n\t\t\t\t\t\t\t</template>\n\t\t\t\t\t\t</sw-collapse>\n\t\t\t\t\t\t<sw-button @click=\"addNew\" class=\"sw-button--primary\">{{$tc('cmsbundle.element.accordion.config.add-new')}}</sw-button>\n\n\t\t\t\t\t</sw-container>\n\t\t\t\t{% endblock %}\n\t\t\t</template>\n\t\t</sw-tabs>\n\t</div>\n{% endblock %}\n";